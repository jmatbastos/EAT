{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
<style>
radio label {
	padding-left: 10px;
}
</style>
{% endblock %}

{% block body %}

<div class="super_container">

	<!-- Header -->

	<header class="header">
			
		<!-- Header Content -->
		<div class="header_container">
			<div class="container">
				<div class="row">
					<div class="col">
						<div class="header_content d-flex flex-row align-items-center justify-content-start">
							<div class="logo_container">
								<a href="#">
									<div class="logo_content d-flex flex-row align-items-end justify-content-start">
										<div class="logo_img"><img src="{{asset('images')}}/logo.png" alt=""></div>
										<div class="logo_text">learn</div>
									</div>
								</a>
							</div>
							<nav class="main_nav_contaner ml-auto">
								<ul class="main_nav">
									<li><a class="nav-link" href="{{path('elearn')}}">Home</a></li>									
									<li class="active"><a class="nav-link" href="#">{{'Register' | trans}}</a></li>
								</ul>
							</nav>

						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<!-- Contact -->

	<div class="contact" style="background-image:url({{asset('images')}}/contact.jpg); background-repeat: no-repeat;">>
	
		<div class="container">
			<div class="row row-xl-eq-height">
				<div class="col-xl-3">
				</div>					
				<!-- Contact Content -->
				<div class="col-xl-6">
					<div class="contact_content">
						<div class="contact_form_container">
							{{ form_start(registrationForm) }}							
								<div class="row">
									<div class="col-lg-6 contact_name_col">
										{{ form_label(registrationForm.name, 'Name:') }}
										{{ form_widget(registrationForm.name, {'attr': {'class': 'contact_input'}}) }}
									</div>
									<div class="col-lg-6">
										{{ form_label(registrationForm.email, 'Email:') }}											
										{{ form_widget(registrationForm.email, {'attr': {'class': 'contact_input'}}) }}
									</div>
								</div>
								<br>
								<div class="row">
									<div class="col-lg-6 contact_name_col">
										{{ form_label(registrationForm.plainPassword.first) }}
										{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'contact_input'}}) }}
									</div>
									<div class="col-lg-6">
										{{ form_label(registrationForm.plainPassword.second) }}
										{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'contact_input'}}) }}
									</div>
								</div>								
								<br>

								{{ form_widget(registrationForm.role) }}
						

								<br>
								{{ form_errors(registrationForm.name) }}
								{{ form_errors(registrationForm.email) }}
								{{ form_errors(registrationForm.plainPassword.first) }}
								{{ form_errors(registrationForm.plainPassword.second) }}
								
								<a href="{{path('login')}}" class="btn btn-outline-warning btn-lg">{{'Cancel' | trans}}</a>															
								<input type="submit" class="btn btn-outline-primary btn-lg float-right" value="{{'Register' | trans}}">
							{{ form_end(registrationForm) }}
						</div>

					</div>
				</div>
				<div class="col-xl-3">
				</div>	
			</div>
		</div>				
	</div>
</div>

{% endblock %}
 
