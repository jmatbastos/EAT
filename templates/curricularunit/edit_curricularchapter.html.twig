{% extends 'base.html.twig' %}

{% block title %}Edit Curricular Chapter{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
{% endblock %}

{% block body %}

<div class="super_container">



	<!-- Contact -->

	<div class="contact" >
	
		<div class="container">
			<div class="row row-xl-eq-height">


				<div class="col-xl-3">
				</div>					
				<!-- Contact Content -->

				<div class="col-xl-6">

					<div class="contact_content">
						<div class="contact_form_container">
							{% for message in app.flashes('notice') %}
								<div class="alert alert-warning" style="text-align:center">
								{{ message | trans }}
								</div>
							{% endfor %}						
							{% if errors > 0 %}
							   <h2>{{'Validation failed' | trans}}</h2>
							   <ul>
							   {% for field, errorMessage in errorMessages %}
								   <li>{{ errorMessage | trans }}</li>
							   {% endfor %}
							   </ul>
							   <br>
							{% endif %}						
							<form id="form1" method="post">
								<input type="hidden" name="csrf_token" value="{{ csrf_token('edit_curricularchapter') }}">
								
								<div class="form-group">
									<label>{{'Curricular Chapter Name' | trans}}</label>
									<input class="form-control" type="text" size="60" name="name" value="{{curricularchapter.description}}">	
								</div>
								<br>
								
								


							</form>								
															
								<br>
								<br>
								<a id="close"  class="btn btn-outline-warning btn-lg" >{{'Cancel' | trans}}</a>
														
								<input form="form1" type="submit" class="btn btn-outline-primary btn-lg float-right" value="{{'Submit' | trans}}">

						

						</div>

					</div>
				</div>

				<div class="col-xl-3">	
				</div>

			</div>
		</div>				
	</div>
</div>

{% endblock %}

{% block javascript %}
<script src="{{ asset('js') }}/jquery-3.2.1.min.js"></script>
<script>
	$(function () {
	  $('#close').click(function () {
		window.close()
		return false
	  })
	})
</script>

{% endblock %}






