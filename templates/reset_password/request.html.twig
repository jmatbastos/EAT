

{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
{% endblock %}

{% block body %}

<div class="super_container">

	<!-- Header -->

	<header class="header">
			
		<!-- Header Content -->
		<div class="header_container">
			<div class="container">
				<div class="row">
					<div class="col">
						<div class="header_content d-flex flex-row align-items-center justify-content-start">
							<div class="logo_container">
								<a href="#">
									<div class="logo_content d-flex flex-row align-items-end justify-content-start">
										<div class="logo_img"><img src="{{asset('images')}}/logo.png" alt=""></div>
										<div class="logo_text">learn</div>
									</div>
								</a>
							</div>
							<nav class="main_nav_contaner ml-auto">
								<ul class="main_nav">
									<li><a class="nav-link" href="{{path('elearn')}}">Home</a></li>									
									<li class="active"><a class="nav-link" href="{{path('login')}}">Login</a></li>
								</ul>
							</nav>

						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<!-- Contact -->

	<div class="contact" style="background-image:url({{asset('images')}}/contact.jpg); background-repeat: no-repeat;">>
	
		<div class="container">
			<div class="row row-xl-eq-height">
            	<div class="col-xl-3">
				</div>	
				<!-- Contact Content -->
				<div class="col-xl-6">
					<div class="contact_content">
						<div class="contact_form_container">
                            {% for flash_error in app.flashes('reset_password_error') %}
                                <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                            {% endfor %}
                            <h2>Password Reset</h2>
							{{ form_start(requestForm) }}							
								<div class="row">
									<div class="col-lg-12">
										{{ form_label(requestForm.email, 'Email:') }}											
										{{ form_widget(requestForm.email, {'attr': {'class': 'contact_input'}}) }}
									</div>
								</div>
								<br>

                                <div>
                                    <p>
                                        {{'Enter your email address and we will send you a link to reset your password' | trans}}.
                                    </p>
                                </div> 
								<br>
								<button class="btn btn-outline-primary btn-lg float-right">{{'Send password reset email' | trans}}</button>							
							{{ form_end(requestForm) }}
						</div>

					</div>
				</div>
                <div class="col-xl-3">
				</div>	          
            </div>
		</div>				
	</div>
</div>

{% endblock %}








