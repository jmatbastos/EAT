{% extends 'base.html.twig' %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
{% endblock %}

{% block body %}

<div class="super_container">

	<!-- Header -->

	<header class="header">
			
		<!-- Header Content -->
		<div class="header_container">
			<div class="container">
				<div class="row">
					<div class="col">
						<div class="header_content d-flex flex-row align-items-center justify-content-start">
							<div class="logo_container">
								<a href="#">
									<div class="logo_content d-flex flex-row align-items-end justify-content-start">
										<div class="logo_img"><img src="{{asset('images')}}/logo.png" alt=""></div>
										<div class="logo_text">learn</div>
									</div>
								</a>
							</div>
							<nav class="main_nav_contaner ml-auto">
								<ul class="main_nav">
									<li><a class="nav-link" href="{{path('elearn')}}">Home</a></li>									
									<li class="active"><a class="nav-link" href="{{path('login')}}">Login</a></li>
								</ul>
							</nav>

						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<!-- Contact -->

	<div class="contact" style="background-image:url({{asset('images')}}/contact.jpg); background-repeat: no-repeat;">>
	
        <div class="container">
			<div class="row row-xl-eq-height">
            	<div class="col-xl-2">
				</div>	
				<!-- Contact Content -->
				<div class="col-xl-8">
					<div class="contact_content">
                        <h3>
                            {{'If an account matching your email exists, then an email was just sent that contains a link that you can use to reset your password' | trans}}.
                            {{'This link will expire in' | trans}} {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                        </h3>
                        <h3>{{'If you didn\'t receive an email please check your spam folder or' | trans}} <a href="{{ path('app_forgot_password_request') }}">{{'try again' | trans}}</a>.</h3>


					</div>
				</div>
                <div class="col-xl-2">
				</div>	          
            </div>
		</div>				
	</div>
</div>

{% endblock %}







