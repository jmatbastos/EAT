{% extends 'base.html.twig' %}

{% block title %}Exams{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/news.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/news_responsive.css">
<style>
	.float{
		position:fixed;
		bottom:80px;
		right:20px;
	}
</style>
{% endblock %}

{% block body %}

<div class="super_container">

	<!-- Header -->

	<header class="header">
	

			
		<!-- Header Content -->
		<div class="header_container">
			<div class="container">
				{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
				<p style="text-align:right"><small>{{'You are logged in as' | trans}} {{app.user.name}}
					{% if is_granted('ROLE_ADMIN') %}
					&nbsp(Administrator)
					{% endif %}					
				</small></p>
				<div class="row">

		{% endif %}	
					<div class="col">
						<div class="header_content d-flex flex-row align-items-center justify-content-start">
							<div class="logo_container">
								<a href="#">
									<div class="logo_content d-flex flex-row align-items-end justify-content-start">
										<div class="logo_img"><img src="{{asset('images')}}/logo.png" alt=""></div>
										<div class="logo_text">learn</div>
									</div>
								</a>
							</div>
							<nav class="main_nav_contaner ml-auto">
								<ul class="main_nav">
									<li><a class="nav-link" href="{{path('menu')}}">{{'Home' | trans}}</a></li>
									{% if is_granted('ROLE_TEACHER') %}
									<li class="nav-item dropdown">
										<a style="background-color: #ff8a00; color: white;" class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">{{'New Exam' | trans}}</a>
										<div class="dropdown-menu">
										  <a class="dropdown-item" href="{{path('exam', {'type': 1}) }}">Random</a>
										  <a class="dropdown-item" href="{{path('exam', {'type': 2}) }}">Manual</a>
										</div>
									 </li>	
									 {% endif %}
								</ul>
							</nav>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>
	

	<!-- News -->
	<div class="news">
		<div class="container">
		
			<div class="row justify-content-center">
				<div class="col-xl-12">
					{% for message in app.flashes('notice') %}
						<div class="alert alert-warning" style="text-align:center">
						{{ message | trans }}
						</div>
					{% endfor %}
				</div>
			</div>
			
			{%for e in exams %}
				{% if e.visibility=='1' or is_granted('ROLE_TEACHER') %}			
				<div class="row">

							<div class="col-lg-8">
										<div class="news_post_date"><a href="#">{{'Creation Date' | trans}}: {{e.creation_date}}</a></div>
										<div class="news_post_title"><a href="{{path('exam/show', {'id': e.exams_id}) }}">{{e.exams_name}}</a></div>	
										<div class="news_post_meta d-flex flex-row align-items-start justify-content-start"></div>
										<div class="news_post_author">{{'By' | trans}} <a href="#">{{e.user}}</a></div>
										{% if (is_granted('ROLE_ADMIN') or (e.users_id==users_id)) %}
											{% if e.visibility == 1 %}
											<div class="news_post_author"><a data-toggle="tooltip" title="Click to toggle visibility!" data-placement="top" onclick="myToggle(event,'{{e.exams_id}}')" href="{{ path('exam_toggle_visibility', {id: e.exams_id}) }}" id="exam-{{e.exams_id}}" class="fa fa-eye"><i>&nbsp; {{'Exam is visible to students' | trans }}</i></a></div>
											{% else %}
											<div class="news_post_author"><a data-toggle="tooltip" title="Click to toggle visibility!" data-placement="top" onclick="myToggle(event,'{{e.exams_id}}')" href="{{ path('exam_toggle_visibility', {id: e.exams_id}) }}" id="exam-{{e.exams_id}}" class="fa fa-eye-slash"><i>&nbsp; {{'Exam is hidden to students' | trans}}</i></a></div>								
											{% endif %}
										{% endif %}										
							</div>

							<div class="col-lg-4">
								<table class="table table-bordered table-sm">
								<tr>
									<td><div style="width: 100%;" class="button button_2"><a href="{{path('exam/show', {'id': e.exams_id}) }}">{{'show' | trans}} &nbsp; &nbsp; <div class="button_arrow"><i class="fa fa-angle-right" aria-hidden="true"></i></div></a></div></td>
									<td><div style="width: 100%;" class="button button_2"><a href="#" onclick="openWindow('{{path('exam/answer', {'id': e.exams_id}) }}');" >{{'attempt' | trans}}<div class="button_arrow"><i class="fa fa-angle-right" aria-hidden="true"></i></div></a></div></td>
								</tr>

								{% if (is_granted('ROLE_ADMIN') or (e.users_id==users_id)) %}
								<tr>								
									<td><div style="width: 100%;" class="button button_2"><a href="{{path('exam/results', {'id': e.exams_id}) }}">{{'Results' | trans}}<div class="button_arrow"><i class="fa fa-angle-right" aria-hidden="true"></i></div></a></div></td>					
									<td><div style="width: 100%;" class="button button_2"><a data-confirm="{{'Are you sure you want to delete this exam' | trans}}?" href="{{path('exam/delete', {'id': e.exams_id}) }}">{{'Delete' | trans}} &nbsp;<div class="button_arrow"><i class="fa fa-angle-right" aria-hidden="true"></i></div></a></div></td>
								</tr>
								{% endif %}							
								</table>	
							</div>
				</div>
				<hr>
				{% endif %}						
			{% endfor %}
			
			{% if exams is empty %}
					<br><br><br>
					<p style="text-align:center;"> {{'The exams database is empty' | trans}}</p>
					<br><br><br>
			{% endif %}

			<a href="{{path('menu')}}" class="btn btn-outline-warning btn-lg float" style="float:right;">{{'Close' | trans}}</a>	
				
				{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
					<p><small>{{'You are logged in as' | trans}} {{ app.user.name }}
					{% if is_granted('ROLE_ADMIN') %}
						&nbsp(Administrator)
					{% endif %}											
					</small></p>
			   {% endif %}			
		 </div>	

	</div>

</div>

{% endblock %}

{% block javascript %}
{{ parent() }}

<script language='Javascript'>
<!--
  // Function to open new window containing window_src
  function openWindow(window_src)
  {		
	window.open(window_src,'_blank',`height=${screen.height},width=${screen.width}`);
  }
-->
</script>

<script>

function myToggle(e,id) {
	e.preventDefault();
						
	$.get($("#exam-"+id).attr('href'),
		function(data, status){
			object = JSON.parse(data);
			if (object.visibility == '1') {
					$("#exam-"+id).html('<i>&nbsp; {{"Exam is visible to students" | trans}}</i>');		
					$("#exam-"+id).attr("class", "fa fa-eye"); 
			}
			else {
					$("#exam-"+id).html('<i>&nbsp; {{"Exam is hidden to students" | trans}}</i>');		
					$("#exam-"+id).attr("class", "fa fa-eye-slash"); 		
			};
		
	});						
							
}

</script>

<script>
$(document).on('click', ':not(form)[data-confirm]', function(e){
    if(!confirm($(this).data('confirm'))){
        e.stopImmediatePropagation();
        e.preventDefault();
    }
});
</script>

{% endblock %}





									





