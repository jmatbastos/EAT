{% extends 'base.html.twig' %}

{% block title %}Exam{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
{% endblock %}

{% block body %}

<div class="super_container">

	<!-- Header -->

	<header class="header">
			
		<!-- Header Content -->
		<div class="header_container">
			<div class="container">
				<div class="row">
					<div class="col">
						<div class="header_content d-flex flex-row align-items-center justify-content-start">
							<div class="logo_container">
								<a href="#">
									<div class="logo_content d-flex flex-row align-items-end justify-content-start">
										<div class="logo_img"><img src="{{asset('images')}}/logo.png" alt=""></div>
										<div class="logo_text">learn</div>
									</div>
								</a>
							</div>
							<nav class="main_nav_contaner ml-auto">
								<ul class="main_nav">
									<li><a class="nav-link" href="{{path('elearn')}}">{{'Home' | trans}}</a></li>
									{% if (is_granted('ROLE_ADMIN') or (exam.users_id==users_id)) %}
									<li class="active"><a class="nav-link" href="{{path('exam/edit', {'id' : exam.exams_id})}}">{{'Edit Exam' | trans}}</a></li>
									{% endif %}
									<li><a class="nav-link" href="{{ path('exams', {'id' : curricularunits_id}) }}">{{'Exams' | trans}}</a></li>										
								</ul>
							</nav>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<!-- Contact -->

	<div class="contact_content">
	
		<div class="container">
		
			<div class="row justify-content-center">
				<div class="col-xl-12">
					{% for message in app.flashes('notice') %}
						<div class="alert alert-warning" style="text-align:center">
						{{ message  | trans }}
						</div>
					{% endfor %}
				</div>
			</div>		
		
			<div class="row row-xl-eq-height">		
				<div class="col-xl-3">			
					<p> <strong>{{'Time' | trans}}:</strong> {{exam.resolution_time}} minutes</p>
					<p> <strong>{{'Total number of questions' | trans}}:</strong> {{exam.questions_total}}</p>
					<p> <strong>{{'Total number of points' | trans}}:</strong> {{exam.total_points}}</p>
				</div>
				<div class="col-xl-9" >
					<h2 style="text-align: center;">{{exam.exams_name}}</h2>
					{% autoescape false %}{{exam.exams_introduction}}{% endautoescape %}
				</div>
			</div>
			
			<hr/>
			
			{%for q in questions %}
				<div class="row row-xl-eq-height">
					<div class="col-xl-3">
						<p><strong>{{'Question' | trans}} {{loop.index}}</strong></p>
						<p><strong>{{'Points' | trans}}:</strong> {{q.marks}}</p>				
					</div>					
					<!-- Contact Content -->
					<div class="col-xl-9">
						{% if q.type == 6 %}
							<img class="img-responsive" src="{{asset('uploads/questions')}}/{{q.content}}" alt="">
						{% endif %}
						{% if q.type == 5 %}
							{% autoescape false %}{{q.content}}{% endautoescape %}
						{% endif %}
						{% if q.type == 4 %}
							{% autoescape false %}{{q.content}}{% endautoescape %}
						{% endif %}
					</div>		
				</div>
				<hr/>
			{% endfor %}
			<a href="{{ path('exam/pdf', {'id' : exam.exams_id}) }}" class="btn btn-outline-info btn-lg">{{'Print' | trans}}</a>
			<a href="{{ path('exams', {'id' : curricularunits_id}) }}" class="btn btn-outline-warning btn-lg" style="float:right;">{{'Close' | trans}}</a>
		
		
		
		
		</div>				
	
	</div>

</div>

{% endblock %}





									





