{% extends 'base.html.twig' %}

{% block title %}Results{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
{% endblock %}

{% block body %}

<div class="super_container">

	<!-- Header -->

	<header class="header">
			
		<!-- Header Content -->
		<div class="header_container">
			<div class="container">
				<div class="row">
					<div class="col">
						<div class="header_content d-flex flex-row align-items-center justify-content-start">
							<div class="logo_container">
								<a href="#">
									<div class="logo_content d-flex flex-row align-items-end justify-content-start">
										<div class="logo_img"><img src="{{asset('images')}}/logo.png" alt=""></div>
										<div class="logo_text">learn</div>
									</div>
								</a>
							</div>
							<nav class="main_nav_contaner ml-auto">
								<ul class="main_nav">
									<li><a class="nav-link" href="{{path('elearn')}}">{{'Home' | trans}}</a></li>
									<li class="active"><a class="nav-link" href="{{path('exams',{'id':curricularunits_id})}}">{{'Exams' | trans}}</a></li>								
								</ul>
							</nav>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<br><br>
	
	<div class="contact_content">
		<div class="container">
				<table class="table table-bordered">
				  <thead>
					<tr>
					  <th scope="col"></th>					
					  <th scope="col">{{'User' | trans}}</th>
					  <th scope="col">Email</th>
					  <th scope="col">{{'Started on' | trans}}</th>
					  <th scope="col">{{'Completed' | trans}}</th>
					  <th scope="col">{{'Grade/20' | trans}}</th>	
					  {%for q in questions %}
					  
						<th scope="col">#{{q.id}}</th>

					  {% endfor %} 
					  
					</tr>
				  </thead>
				  <tbody>
				      {% for a in attempts %}
					<tr>
					  <td><a onclick="return confirm('{{'Are you sure you want to delete this attempt' | trans}}?')" href="{{ path('attempt/del', {'id' : a.usermadeexams_id} ) }}"><span class="fa fa-trash" aria-hidden="true"></span></a></td>
					  <th scope="row">{{a.user}}</th>
					  <td>{{a.email}}</td>
					  <td>{{a.start_date}}</td>
					  <td>{{a.finish_date}}</td>
					  <td><a href="{{ path('attempt/grade', {'id' : a.usermadeexams_id}) }}">{{(a.total_grade / total_points * 20) | round(1, 'common')}}</a></td>
					   {% for r in a.results %}
						  <td><a  href="" onclick="openWindow('{{path('attempt/show/answer', {'id': r.answers_id}) }}');" >{{r.grade}}/{{r.marks}}</a></td>	
					   {% endfor %} 
					</tr>
					{% endfor %}

				  </tbody>
				</table> 
				
			</div>
			<br>

			<div style="padding-right: 100px;" class="row justify-content-end">
				<div class="button button_2"><a href="{{path('exam/csv_results', {'id': exams_id}) }}">{{'download in CSV format' | trans}}<div class="button_arrow"><i class="fa fa-angle-right" aria-hidden="true"></i></div></a></div>
			</div>

	</div>

</div>




{% endblock %}

{% block javascript %}

<script language='Javascript'>
<!--
  // Function to open new window containing window_src
  function openWindow(window_src)
  {		
	window.open(window_src,'_blank',`height=${screen.height},width=${screen.width}`);
  }
-->
</script>

{% endblock %}