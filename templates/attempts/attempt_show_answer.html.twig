{% extends 'base.html.twig' %}

{% block title %}Attempt{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/bootstrap4/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/main_styles.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
{% endblock %}

{% block body %}

<div class="super_container">

	<!-- Contact -->

	<div class="contact_content">
	
		<div class="container">
		
 
			

			

				<div class="row row-xl-eq-height">
					<div class="col-xl-3">
						<p><strong>{{'Question' | trans}} #{{q.id}}</strong></p>
						<p><strong>{{'Points' | trans}}:</strong> {{q.marks}}</p>
							<p><strong>{{'grade' | trans}}:</strong> {{a.grade}}</p>
							<form method="post">
							<input type="hidden" name="csrf_token" value="{{ csrf_token('show') }}">							
							<p><a  href="" onclick="openWindow('{{path('attempt/grade/answer', {'id': id}) }}');" class="btn btn-outline-info btn-lg" >{{'Grade' | trans}}</a>
							&nbsp;							
							<input type="submit" class="btn btn-outline-warning btn-lg" value="{{'Close' | trans}}">
							</p>
							</form>	
							

					</div>					
					<!-- Contact Content -->
					<div class="col-xl-9">
						
						<p><strong>{{'Question' | trans}}</strong></p>
						
						{% if q.type == 6 %}
							<img class="img-responsive" src="{{asset('uploads/questions')}}/{{q.content}}" alt="">
						{% endif %}
						{% if q.type == 5 %}
							{% autoescape false %}{{q.content}}{% endautoescape %}
						{% endif %}
						{% if q.type == 4 %}
							{% autoescape false %}{{q.content}}{% endautoescape %}
						{% endif %}
						
						<p><strong>{{'Student answer' | trans}}</strong></p>	
						{% if a.answertypes_id == "5" %}
							{% autoescape false %}{{a.answer}}{% endautoescape %}
						{% endif %}
						
						{% if a.answertypes_id == "6" %}					
							<img src="{{a.answer}}">
						{% endif %}
						
					</div>		
				</div>


		
		
		
		
		
		</div>				
	
	</div>

</div>

{% endblock %}


{% block javascript %}


<script>
<!--
  // Function to open new window containing window_src
  function openWindow(window_src)
  {		
	window.open(window_src,'_blank',`height=${screen.height},width=${screen.width}`);
  }
-->
</script>

{% endblock %}



									





